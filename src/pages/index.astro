---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#172916" />
  <meta name="description" content="Pokémon TFT em Astro + Canvas 2D com partida local contra bots, evolução, economia e combate automático." />
  <title>Pokémon TFT Arena</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>
  <main class="game-shell" data-mode="menu">
    <canvas id="arena" width="1000" height="760" data-base={base} aria-label="Arena Pokémon TFT com inimigos no topo, seu time embaixo e banco físico no mapa." tabindex="0"></canvas>

    <section class="entry-screen" id="entry-screen" aria-label="Iniciar partida local">
      <div class="entry-panel match-setup" id="match-setup">
        <h1>Partida Pokémon TFT</h1>
        <p>Você e os bots começam com 100 HP e 9 de ouro em uma partida local com preparação, combate e arenas observáveis.</p>
        <label for="player-count">Quantidade de participantes</label>
        <select id="player-count" name="player-count">
          <option value="3">3 jogadores · 2 bots</option>
          <option value="4">4 jogadores · 3 bots</option>
          <option value="5">5 jogadores · 4 bots</option>
          <option value="6">6 jogadores · 5 bots</option>
          <option value="7">7 jogadores · 6 bots</option>
          <option value="8">8 jogadores · 7 bots</option>
        </select>
        <div class="setup-actions">
          <button id="confirm-match" class="confirm-local" type="button">Criar partida local</button>
        </div>
      </div>
    </section>

    <section class="top-hud" aria-label="Estado e controles">
      <div class="chapter-label"><b id="round-label">1-1</b><small id="phase-label">Preparação</small></div>
      <div id="chapter-progress" class="chapter-progress" aria-label="Dez fases do capítulo"></div>
      <div class="hud-stat"><small>Unidades</small><b id="limit-label">1/6</b></div>
      <div class="hud-stat gold"><small>Ouro</small><b id="gold-label">9</b></div>
      <div class="hud-stat" id="hp-stat" hidden><small>Vida</small><b id="hp-label">100</b></div>
      <div class="hud-stat" id="alive-stat" hidden><small>Vivos</small><b id="alive-label">1/1</b></div>
      <div class="hud-stat" id="timer-stat" hidden><small>Tempo</small><b id="timer-label">30s</b></div>
      <button id="return-menu" class="return-menu" type="button">Menu</button>
      <div class="phase-progress" role="progressbar" aria-label="Tempo restante da etapa" aria-valuemin="0" aria-valuemax="100" id="phase-progress"><i id="phase-progress-fill"></i></div>
    </section>

    <aside id="damage-panel" class="damage-panel" hidden aria-label="Dano dos seus Pokémon na última fase">
      <button id="toggle-damage" type="button" aria-expanded="false" aria-controls="damage-content">⚔ <span>Dano</span><span id="damage-chevron">‹</span></button>
      <div id="damage-content" hidden><div class="damage-heading"><b>Dano causado</b><small id="damage-round">Última fase</small></div><div id="damage-ranking"></div></div>
    </aside>
    <aside id="match-panel" class="match-panel" hidden aria-label="Participantes da partida local">
      <div class="match-panel-heading"><div><b>Participantes</b><small id="observed-label">Sua arena</small></div><small id="match-id-label">Offline</small></div>
      <div id="match-players" class="match-players"></div>
      <button id="back-own-arena" class="back-own-arena" type="button" hidden>Voltar à minha arena</button>
      <p class="match-pending" id="match-panel-note">Partida local com bots.</p>
    </aside>

    <aside id="environment-panel" class="environment-panel" hidden aria-label="Tipos e vantagens do campo">
      <div class="environment-title">Tipos</div>
      <div id="environment-effects" class="environment-effects"></div>
    </aside>

    <section class="side-hud collapsed" id="detail-panel" aria-label="Ficha do Pokémon selecionado">
      <div class="panel-title"><span id="selected-number">#004</span><b id="selected-name">Charmander</b></div>
      <div class="selected-head">
        <canvas id="selected-avatar" width="78" height="70" aria-hidden="true"></canvas>
        <div>
          <small id="selected-type">Fogo</small>
          <strong id="selected-place">Campo</strong>
          <p id="selected-iv">IV geral 50%</p>
          <p id="sell-value">Venda: 3 ouro</p>
        </div>
      </div>
      <div id="stats-list" class="stats-list"></div>
      <div class="attack-panel">
        <div class="panel-subtitle">Ataques</div>
        <div id="moves-active" class="moves-list"></div>
        <div class="attack-actions">
          <button id="sell-selected" type="button">Vender</button>
        </div>
      </div>
    </section>

    <section class="bottom-hud" aria-label="Loja">
      <div class="shop-meta">
        <div id="economy-bonuses" class="economy-bonuses" aria-label="Bônus de renda"></div>
        <div id="consumables" class="consumables" aria-label="Pokébolas de clonagem"></div>
        <div class="shop-actions">
          <span class="shop-gold" aria-label="Ouro disponível"><span class="gold-emblem" aria-hidden="true">●</span><b id="shop-gold-value">9</b></span>
          <button id="reroll-shop" type="button" title="Atualizar ofertas por 2 de ouro"><span class="reroll-icon" aria-hidden="true">↻</span> <span>2</span></button>
          <button id="lock-shop" class="lock-button" type="button" aria-label="Travar loja" title="Travar loja" aria-pressed="false" hidden><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></button>
        </div>
      </div>
      <div class="shop-content">
        <div id="shop-rarity-odds" class="shop-rarity-odds" hidden aria-label="Chances de raridade do capítulo"></div>
        <div id="bet-controls" class="special-controls" hidden>
          <select id="bet-prediction" aria-label="Previsão da aposta"><option value="win">Vitória</option><option value="loss">Derrota</option></select>
          <input id="bet-amount" aria-label="Ouro apostado" type="number" min="1" max="5" step="1" value="1" />
          <button id="confirm-bet" type="button">Apostar</button><small id="bet-status"></small>
        </div>
        <div id="pve-controls" class="special-controls" hidden>
          <label for="pve-difficulty">PvE</label><select id="pve-difficulty"><option value="easy">Fácil</option><option value="medium">Médio</option><option value="hard">Difícil</option></select><small id="pve-budget"></small>
        </div>
        <small id="pending-rewards" aria-live="polite"></small>
        <div id="shop-slots" class="shop-slots" aria-label="Seis ofertas de Pokémon e duas flexíveis. Arraste para o banco ou campo."></div>
      </div>
      <div id="compass-widget" class="compass-widget" hidden role="img" aria-label="Distribuição de pontos dos tipos">
        <div class="compass-ring" id="compass-ring"><div id="compass-icons" class="compass-icons"></div><div class="compass-ring-inner"><span class="compass-star" aria-hidden="true">✦</span></div></div>
      </div>
    </section>

    <div id="toast" class="toast" hidden></div>
    <div id="type-tooltip" class="type-tooltip" role="tooltip" hidden></div>

    <div class="battle-outcome" id="outcome" hidden>
      <div class="outcome-card">
        <small>Batalha encerrada</small>
        <h1 id="result-title">Vitória</h1>
        <p id="result-note">A partida local terminou.</p>
        <button id="again" type="button">Nova partida</button>
      </div>
    </div>
  </main>
  <script>import '../ui/arena.js';</script>
</body>
</html>
