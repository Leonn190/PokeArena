---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#172916" />
  <meta name="description" content="Simulador Pokémon TFT em Astro + Canvas 2D com sprites PMD, loja, banco, evolução, IVs e combate automático." />
  <title>Pokémon TFT Arena</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>
  <main class="game-shell">
    <canvas id="arena" width="1000" height="720" data-base={base} aria-label="Arena Pokémon TFT com inimigos no topo e seu time na parte inferior." tabindex="0"></canvas>

    <section class="top-hud" aria-label="Estado da rodada">
      <div class="hud-brand">
        <span class="pokeball-mark"></span>
        <div><b>Pokémon TFT</b><small id="phase-label">Preparação</small></div>
      </div>
      <div class="hud-stat"><small>Rodada</small><b id="round-label">1</b></div>
      <div class="hud-stat"><small>Limite</small><b id="limit-label">1 / 6</b></div>
      <div class="hud-stat gold"><small>Ouro</small><b>∞</b></div>
      <div class="hud-stat"><small>Tempo</small><b id="clock">00:00</b></div>
      <div class="hud-actions">
        <button id="start" class="icon-button primary" type="button" title="Iniciar batalha" aria-label="Iniciar batalha">▶</button>
        <button id="next-round" class="icon-button" type="button" title="Próxima rodada" aria-label="Próxima rodada">↻</button>
      </div>
    </section>

    <section class="side-hud" aria-label="Ficha do Pokémon selecionado">
      <div class="panel-title"><span id="selected-number">#004</span><b id="selected-name">Charmander</b></div>
      <div class="selected-head">
        <canvas id="selected-avatar" width="78" height="70" aria-hidden="true"></canvas>
        <div>
          <small id="selected-type">Fogo</small>
          <strong id="selected-place">Banco</strong>
          <p id="selected-iv">IV geral 50%</p>
        </div>
      </div>
      <div id="stats-list" class="stats-list"></div>
      <div class="attack-panel">
        <div class="panel-subtitle">Ataques</div>
        <div id="moves-active" class="moves-list"></div>
        <div class="attack-actions">
          <button id="reroll-move" type="button">Reroll 2</button>
          <button id="unlock-move" type="button">+ Slot 4</button>
        </div>
      </div>
    </section>

    <section class="enemy-hud" aria-label="Criar inimigos">
      <div class="panel-subtitle">Inimigos</div>
      <div id="enemy-picks" class="enemy-picks"></div>
      <small>Escolha e clique na arena de cima.</small>
    </section>

    <section class="bottom-hud" aria-label="Banco e loja">
      <div class="bench-row" id="bench-row" aria-label="Banco de 10 slots"></div>
      <div class="shop-row">
        <div class="shop-meta">
          <b>Loja</b>
          <button id="reroll-shop" type="button">Reroll 2</button>
        </div>
        <div id="shop-slots" class="shop-slots" aria-label="Loja de 6 slots"></div>
      </div>
    </section>

    <section id="battle-log" class="battle-log" aria-live="polite"></section>

    <div class="battle-outcome" id="outcome" hidden>
      <div class="outcome-card">
        <small>Batalha encerrada</small>
        <h1 id="result-title">Vitória</h1>
        <p id="result-note">Prepare a próxima rodada.</p>
        <button id="again" type="button">Preparar próxima rodada</button>
      </div>
    </div>
  </main>
  <script>import '../scripts/arena.js';</script>
</body>
</html>
