---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#172916" />
  <meta name="description" content="Pokémon TFT em Astro + Canvas 2D com partida local contra bots, evolução, economia e combate automático." />
  <title>Pokémon TFT Arena</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>
  <main class="game-shell" data-mode="menu">
    <canvas id="arena" width="1000" height="760" data-base={base} aria-label="Arena Pokémon TFT com inimigos no topo, seu time embaixo e banco físico no mapa." tabindex="0"></canvas>

    <section class="entry-screen" id="entry-screen" aria-label="Menu principal">
      <div class="entry-backdrop" aria-hidden="true"><span class="hero-ball"></span><span class="hero-orbit orbit-one"></span><span class="hero-orbit orbit-two"></span></div>
      <div class="entry-hero">
        <div class="entry-eyebrow">AUTO BATTLER · POKÉMON</div>
        <h1>POKÉ<span>ARENA</span></h1>
        <p>Construa sua equipe. Evolua seus Pokémon. Sobreviva aos capítulos.</p>
        <label class="entry-party">Participantes na partida <select id="player-count" aria-label="Número de jogadores"><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8" selected>8</option></select></label>
        <div class="entry-buttons">
          <button id="confirm-match" class="primary-start" type="button"><span>⚔</span> Puxar partida <span class="action-arrow">↗</span></button>
          <button id="open-roster" class="secondary-start" type="button"><span>◈</span> Ver elenco <span class="action-arrow">↗</span></button>
        </div>
        <div class="entry-caption">Partida local contra bots · sem conexão online</div>
      </div>
    </section>

    <section class="roster-screen" id="roster-screen" hidden aria-label="Elenco de Pokémon">
      <header class="roster-header"><div><small>POKÉARENA / ARQUIVO</small><h2>Elenco Pokémon</h2><p>Espécies disponíveis, raridades e tipos</p></div><button id="close-roster" type="button">← Voltar</button></header>
      <div class="roster-toolbar"><input id="roster-search" type="search" placeholder="Pesquisar Pokémon pelo nome ou número" aria-label="Pesquisar Pokémon" /><select id="roster-rarity" aria-label="Filtrar raridade"><option value="">Todas as raridades</option><option value="comum">Comum</option><option value="incomum">Incomum</option><option value="raro">Raro</option><option value="epico">Épico</option><option value="mitico">Mítico</option><option value="lendario">Lendário</option></select><span id="roster-count"></span></div>
      <div class="roster-grid" id="roster-grid"></div>
    </section>

    <section class="top-hud" aria-label="Capítulo e progresso da partida">
      <div class="chapter-badge" id="round-label">1-1</div>
      <div class="chapter-track"><div id="chapter-progress" class="chapter-progress" aria-label="Dez fases do capítulo"></div><div class="chapter-track-numbers" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span></div></div>
      <div class="chapter-meta"><b id="chapter-name">Capítulo 1</b><span id="stage-name">Batalha normal</span><small id="phase-label">Preparação</small></div>
      <button id="return-menu" class="return-menu" type="button" title="Voltar ao menu">⌂</button>
      <div id="legacy-hud" hidden><span id="limit-label"></span><span id="gold-label"></span><span id="hp-stat"></span><span id="hp-label"></span><span id="alive-stat"></span><span id="alive-label"></span><span id="timer-stat"></span><span id="timer-label"></span></div>
      <div class="phase-progress" role="progressbar" aria-label="Tempo restante da etapa" aria-valuemin="0" aria-valuemax="100" id="phase-progress"><i id="phase-progress-fill"></i></div>
    </section>

    <aside id="damage-panel" class="damage-panel" hidden aria-label="Dano dos seus Pokémon na última fase">
      <button id="toggle-damage" type="button" aria-expanded="false" aria-controls="damage-content">⚔ <span>Dano</span><span id="damage-chevron">‹</span></button>
      <div id="damage-content" hidden><div class="damage-heading"><b>Dano causado</b><small id="damage-round">Última fase</small></div><div id="damage-ranking"></div></div>
    </aside>
    <aside id="match-panel" class="match-panel" hidden aria-label="Participantes da partida local">
      <div class="match-panel-heading"><div><b>Participantes</b><small id="observed-label">Sua arena</small></div><small id="match-id-label">Offline</small></div>
      <div id="match-players" class="match-players"></div>
      <button id="back-own-arena" class="back-own-arena" type="button" hidden>Voltar à minha arena</button>
      <p class="match-pending" id="match-panel-note">Partida local com bots.</p>
    </aside>

    <aside id="environment-panel" class="environment-panel" hidden aria-label="Tipos e vantagens do campo">
      <div class="environment-title">Tipos</div>
      <div id="environment-effects" class="environment-effects"></div>
    </aside>

    <section class="side-hud collapsed" id="detail-panel" aria-label="Ficha do Pokémon selecionado">
      <div class="panel-title"><span id="selected-number">#004</span><b id="selected-name">Charmander</b></div>
      <div class="selected-head">
        <canvas id="selected-avatar" width="78" height="70" aria-hidden="true"></canvas>
        <div>
          <small id="selected-type">Fogo</small>
          <strong id="selected-place">Campo</strong>
          <p id="selected-iv">IV geral 50%</p>
          <p id="sell-value">Venda: 3 ouro</p>
        </div>
      </div>
      <div id="stats-list" class="stats-list"></div>
      <div class="attack-panel">
        <div class="panel-subtitle">Ataques</div>
        <div id="moves-active" class="moves-list"></div>
        <div class="attack-actions">
          <button id="sell-selected" type="button">Vender</button>
        </div>
      </div>
    </section>

    <section class="bottom-hud" aria-label="Loja de seis ofertas">
      <button id="lock-shop" class="lock-button shop-tab-lock" type="button" aria-label="Travar loja" title="Travar loja" aria-pressed="false"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></button>
      <div class="shop-meta">
        <div class="shop-finances"><div class="shop-gold" aria-label="Ouro disponível"><span class="gold-emblem" aria-hidden="true">●</span><b id="shop-gold-value">9</b></div><div class="next-income"><small>Próxima renda · máximo base</small><strong id="next-income">+6</strong></div></div>
        <div id="economy-bonuses" class="economy-bonuses" aria-label="Bônus de renda"></div>
        <div id="consumables" class="consumables" aria-label="Pokébolas de clonagem"></div>
        <div class="shop-actions"><button id="reroll-shop" type="button" title="Atualizar ofertas por 2 de ouro"><span class="reroll-icon" aria-hidden="true">↻</span><span>Atualizar · 2 <span class="gold-small">●</span></span></button></div>
      </div>
      <div class="shop-content">
        <div id="shop-rarity-odds" class="shop-rarity-odds" hidden aria-label="Chances de raridade do capítulo"></div>
        <small id="pending-rewards" aria-live="polite"></small>
        <div id="shop-offers" class="shop-offers">
          <div id="shop-slots" class="shop-slots" aria-label="Seis ofertas, sendo quatro de Pokémon e duas flexíveis. Arraste para o banco ou campo."></div>
          <div id="shop-sale-area" class="shop-sale-area" hidden aria-live="polite"></div>
        </div>
      </div>
      <div id="compass-widget" class="compass-widget" hidden role="img" aria-label="Distribuição de pontos dos tipos"><div class="compass-ring" id="compass-ring"><div id="compass-icons" class="compass-icons"></div><div class="compass-ring-inner"><span class="compass-star" aria-hidden="true">✦</span></div></div></div>
    </section>

    <div class="special-overlay" id="special-overlay" hidden>
      <div class="special-dialog" role="dialog" aria-modal="true" aria-labelledby="special-title"><div class="special-eyebrow" id="special-eyebrow">ESCOLHA DE FASE</div><h2 id="special-title">Sua decisão</h2><p id="special-description"></p>
        <div id="bet-controls" class="special-controls" hidden><div class="choice-grid"><label for="bet-prediction">Resultado previsto</label><select id="bet-prediction"><option value="win">Vitória</option><option value="loss">Derrota</option></select><label for="bet-amount">Valor apostado (1–5)</label><input id="bet-amount" type="number" min="1" max="5" step="1" value="1" /></div><small id="bet-status"></small><button id="confirm-bet" type="button" class="special-primary">Confirmar aposta</button><button id="skip-bet" type="button" class="special-skip">Seguir sem apostar</button></div>
        <div id="pve-controls" class="special-controls" hidden><div class="difficulty-grid"><button type="button" data-difficulty="easy"><b>Fácil</b><small>80% dos atributos</small></button><button type="button" data-difficulty="medium"><b>Médio</b><small>100% dos atributos</small></button><button type="button" data-difficulty="hard"><b>Difícil</b><small>125% de HP e ataque</small></button></div><select id="pve-difficulty" hidden><option value="easy">Fácil</option><option value="medium">Médio</option><option value="hard">Difícil</option></select><small id="pve-budget"></small><button id="confirm-difficulty" class="special-primary" type="button">Confirmar dificuldade</button></div>
      </div>
    </div>

    <div id="trainer-layer" class="trainer-layer" aria-hidden="true"></div>
    <div id="toast" class="toast" hidden></div>
    <div id="type-tooltip" class="type-tooltip" role="tooltip" hidden></div>

    <div class="battle-outcome" id="outcome" hidden>
      <div class="outcome-card">
        <small>Batalha encerrada</small>
        <h1 id="result-title">Vitória</h1>
        <p id="result-note">A partida local terminou.</p>
        <button id="again" type="button">Nova partida</button>
      </div>
    </div>
  </main>
  <script>import '../ui/arena.js';</script>
</body>
</html>
